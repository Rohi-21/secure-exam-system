{
  "name": "secure-exam-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npx tsx --test tests/crypto/merkle.test.ts tests/crypto/commitment.test.ts tests/crypto/shamir.test.ts tests/security/audit-chain.test.ts tests/security/ecdh-pfs.test.ts tests/security/watermark.test.ts tests/integration/stage7-workflows.test.ts tests/e2e/full-flow.test.ts",
    "test:crypto": "npx tsx --test tests/crypto/merkle.test.ts tests/crypto/commitment.test.ts tests/crypto/shamir.test.ts",
    "test:security": "npx tsx --test tests/security/audit-chain.test.ts tests/security/ecdh-pfs.test.ts tests/security/watermark.test.ts",
    "test:integration": "npx tsx --test tests/integration/stage7-workflows.test.ts",
    "test:e2e": "npx tsx --test tests/e2e/full-flow.test.ts",
    "bench:cipher": "npx tsx tests/crypto/cipher-benchmark.ts",
    "bench:kdf": "npx tsx tests/crypto/kdf-benchmark.ts",
    "bench:all": "npm run bench:cipher && npm run bench:kdf",
    "seed": "npx tsx prisma/seed.ts",
    "generate-keys": "npx tsx scripts/generate-server-keys.ts",
    "typecheck": "npx tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "argon2": "^0.45.2",
    "bcrypt": "^6.0.0",
    "jose": "^6.2.17",
    "next": "16.4.6",
    "nodemailer": "^10.5.0",
    "otpauth": "^9.6.0",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shamirs-secret-sharing": "^2.0.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
